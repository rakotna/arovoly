# AgroField AI — Backend Environment Configuration
DEBUG=True
SECRET_KEY=agrofield-ai-secret-development-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL / PostGIS or SQLite for dev)
DATABASE_URL=sqlite:///db.sqlite3

# Geospatial Imagery Providers
IMAGERY_PROVIDER=esri
ESRI_IMAGERY_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
MAXAR_IMAGERY_URL=
MAXAR_API_KEY=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
