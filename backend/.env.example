# AROVOLY — Backend Environment Configuration
DEBUG=True
SECRET_KEY=arovoly-secret-development-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,.onrender.com

# Database Configuration (PostgreSQL / PostGIS or SQLite for dev)
DATABASE_URL=sqlite:///db.sqlite3

# Cloudinary (copy the full CLOUDINARY_URL from the Cloudinary dashboard)
CLOUDINARY_URL=

# Geospatial Imagery Providers
IMAGERY_PROVIDER=esri
ESRI_IMAGERY_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
MAXAR_IMAGERY_URL=
MAXAR_API_KEY=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=https://your-render-app.onrender.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
FRONTEND_URL=http://localhost:5173

# Email / magic-link configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=AROVOLY <noreply@localhost>
